# Cloudflare Pages headers.

# Nothing is fetched from other origins, but for the map tiles and the
# street-level photos (Mapillary's, served from Facebook's CDN) on the
# calculators page. Only the blog (and its previews) may show the app inside
# its pages, for the "try it here" boxes in its guides (src/lib/demo.js).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https://tile.openstreetmap.org https://*.fbcdn.net; font-src 'self' data:; connect-src 'self' https://graph.mapillary.com https://*.fbcdn.net; worker-src 'self' blob:; media-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self' https://blog.lumiraw.app https://*.margual56.workers.dev

# Hashed assets can be cached forever.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/service-worker.js
  Cache-Control: no-cache

# Fixed names, cached for a day.
/favicon.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/icon-192.png
  Cache-Control: public, max-age=86400
/icon-512.png
  Cache-Control: public, max-age=86400
/icon-maskable-512.png
  Cache-Control: public, max-age=86400
/og.png
  Cache-Control: public, max-age=86400
/manifest.webmanifest
  Cache-Control: public, max-age=86400
/robots.txt
  Cache-Control: public, max-age=86400
/sitemap.xml
  Cache-Control: public, max-age=86400
/samples/*
  Cache-Control: public, max-age=86400
