# Cloudflare Pages applies these to the static responses.
#
# Only fingerprinted paths may be immutable. The wasm module and the lens
# database are imported through the bundler precisely so they land here with a
# content hash in the name; anything served from a fixed path must be allowed
# to go stale, or a deploy leaves browsers mixing old and new halves.

/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker decides what is fresh, so it must itself always be
# fetched fresh, or a deploy would never reach a browser that installed it.
/service-worker.js
  Cache-Control: no-cache

# Fixed names whose contents nothing else depends on: a day out of date costs
# at most a day-old icon or link preview, never a broken page.
#
# The HTML is deliberately not here. Each page names the hashed scripts of its
# own deploy, and a deploy retires the previous one's files, so a page held
# for a day could ask for scripts that no longer exist. Left to the Pages
# default, it is revalidated on every load, which is a 304 when nothing changed.
/favicon.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/icon-192.png
  Cache-Control: public, max-age=86400
/icon-512.png
  Cache-Control: public, max-age=86400
/icon-maskable-512.png
  Cache-Control: public, max-age=86400
/og.png
  Cache-Control: public, max-age=86400
/manifest.webmanifest
  Cache-Control: public, max-age=86400
/robots.txt
  Cache-Control: public, max-age=86400
/sitemap.xml
  Cache-Control: public, max-age=86400
